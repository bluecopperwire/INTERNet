# Application Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password
DATABASE_NAME=internet_db

# Authentication / Security
JWT_ACCESS_SECRET=super_secret_access_key_change_me_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_PENDING_REGISTRATION_SECRET=separate_pending_registration_secret_change_me
GOOGLE_PENDING_REGISTRATION_EXPIRES=10m

# Cookie & Frontend Configuration
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173

# Explicit fake-development seed guard (never enabled in production)
ALLOW_DEV_SEED=false
DEV_SEED_PASSWORD=
