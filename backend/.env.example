# Application Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password
DATABASE_NAME=internet_db

# Authentication / Security
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Cookie & Frontend Configuration
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173

# Explicit bootstrap command inputs (do not commit real values)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Explicit development fixture command inputs (never use production secrets)
ALLOW_DEV_SEED=false
DEV_SEED_PASSWORD=

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM_NAME="QC PESO - Work Immersion and Internship Referral Program"
SMTP_FROM_EMAIL=your_email@gmail.com

# Email Queue Configuration
EMAIL_QUEUE_DELAY_MS=2000
EMAIL_MAX_RETRIES=3

# Referral Letter PDF & Signatory Settings
REFERRAL_WATERMARK_PATH=uploads/static/qc_peso_seal.png
REFERRAL_SIGNATURE_PATH=uploads/static/peso_manager_signature.png
PESO_MANAGER_NAME="ROGELIO L. REYES, MCD"
PESO_MANAGER_TITLE="City Government Department Head III"
PESO_MANAGER_OFFICE="PESO Manager"

