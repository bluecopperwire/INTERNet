# Application Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password
DATABASE_NAME=internet_db

# Authentication / Security
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Cookie & Frontend Configuration
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173

# Private file storage (local/test only until the company file-server contract is supplied)
FILE_STORAGE_DRIVER=local
LOCAL_PRIVATE_STORAGE_ROOT=.private-storage
EMPLOYEE_ID_MAX_BYTES=5242880

# Explicit bootstrap command inputs (do not commit real values)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Explicit development fixture command inputs (never use production secrets)
ALLOW_DEV_SEED=false
DEV_SEED_PASSWORD=
